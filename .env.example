# Copy to .env.local for local development. All variables are server-only.
# On Vercel set them per environment (Development / Preview / Production); see docs/ENVIRONMENTS.md.

# Postgres connection as the app_server role (never the owner or service role).
# Local: password is set by supabase/seed.sql. Hosted: use the pooler URL (port 6543).
DATABASE_URL=postgresql://app_server:app_server_local_only@127.0.0.1:54322/postgres

# Supabase API (from `supabase status` locally).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Used only for the Auth admin API (create/ban staff users). Never for data writes.
SUPABASE_SECRET_KEY=

# Tests only: owner connection used by fixtures (local stack only).
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Terminal channel tokens (Supabase Realtime). Hosted: Project Settings → API → JWT secret.
# Local: the JWT_SECRET printed by `npx supabase status`.
SUPABASE_JWT_SECRET=
# Signal provider: "supabase" (default) or "ably" (then ABLY_API_KEY is required).
SIGNAL_PROVIDER=supabase
ABLY_API_KEY=
